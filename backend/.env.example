PORT=5000
NODE_ENV=development

# MongoDB connection string — local (mongodb://127.0.0.1:27017/ringlead)
# or Atlas (mongodb+srv://<user>:<password>@<cluster>/ringlead)
MONGODB_URI=mongodb://127.0.0.1:27017/ringlead

# Long random strings — never reuse across access/refresh, never commit real values
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed origins for the (future) admin panel web app
CORS_ORIGIN=http://localhost:3000
